# Environment Configuration
DATABASE_URL=sqlite:///./ml_ab_testing.db
# DATABASE_URL=postgresql://user:password@localhost:5432/ml_ab_testing

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=True

# Model Storage
MODEL_STORAGE_PATH=./models

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Security (change in production!)
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256

# CORS Settings
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Experiment Defaults
DEFAULT_TRAFFIC_SPLIT_CHAMPION=80
DEFAULT_TRAFFIC_SPLIT_CHALLENGER=20
DEFAULT_MIN_SAMPLE_SIZE=1000
DEFAULT_SIGNIFICANCE_LEVEL=0.05
